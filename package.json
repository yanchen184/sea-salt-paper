{
  "name": "sea-salt-paper",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "flow:board": "tsx scripts/flow-board/server.ts",
    "flow": "tsx scripts/flow-board/cli.ts",
    "test:board": "vitest run --config vitest.board.config.ts",
    "flow:status": "firebase emulators:exec --only auth,firestore --project demo-sea-salt \"tsx scripts/flow-status.ts\"",
    "manual:screens": "firebase emulators:exec --only auth,firestore --project demo-sea-salt \"playwright test --config playwright.manual.config.ts\"",
    "test:emu": "firebase emulators:exec --only auth,firestore --project demo-sea-salt \"vitest run --config vitest.emu.config.ts && playwright test\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
