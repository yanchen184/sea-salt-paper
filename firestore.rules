rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(room) {
      return request.auth.uid in room.playerUids;
    }

    function isKicked(room) {
      return request.auth.uid in room.kickedUids;
    }

    function isNewRoom(code) {
      let d = request.resource.data;
      return d.code == code
        && d.hostId == request.auth.uid
        && d.status == 'lobby'
        && d.players.size() == 1
        && d.players[0].uid == request.auth.uid
        && d.playerUids == [request.auth.uid]
        && d.kickedUids == []
        && d.game == null
        && d.version == 0;
    }

    function isSelfJoin() {
      let before = resource.data;
      let after = request.resource.data;
      let count = before.players.size();
      return before.status == 'lobby'
        && !isMember(before)
        && !isKicked(before)
        && after.diff(before).affectedKeys().hasOnly(['players', 'playerUids', 'version', 'updatedAt'])
        && after.players.size() == count + 1
        && after.players.size() <= 4
        && after.players[0:count] == before.players
        && after.players[count].uid == request.auth.uid
        && after.playerUids == before.playerUids.concat([request.auth.uid])
        && after.version == before.version + 1;
    }

    match /rooms/{code} {
      function presenceOf(uid) {
        return /databases/$(database)/documents/rooms/$(code)/presence/$(uid);
      }

      function isStale(uid) {
        return !exists(presenceOf(uid))
          || get(presenceOf(uid)).data.lastSeen < request.time - duration.value(45, 's');
      }

      function isValidKick(before, after) {
        let target = after.kickedUids[after.kickedUids.size() - 1];
        return after.kickedUids == before.kickedUids.concat([target])
          && target in before.playerUids
          && target != request.auth.uid
          && after.playerUids == before.playerUids.removeAll([target])
          && isStale(target);
      }

      function isMemberUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        let changed = after.diff(before).affectedKeys();
        let byHost = request.auth.uid == before.hostId;
        return isMember(before)
          && !isKicked(before)
          && changed.hasOnly(['status', 'game', 'players', 'playerUids', 'kickedUids', 'hostId', 'version', 'updatedAt'])
          && after.version == before.version + 1
          && (byHost || !changed.hasAny(['hostId', 'kickedUids']))
          && (!changed.hasAny(['kickedUids']) || (byHost && isValidKick(before, after)))
          && (!changed.hasAny(['playerUids']) || changed.hasAny(['kickedUids'])
              || after.playerUids == before.playerUids.removeAll([request.auth.uid]));
      }

      allow read: if signedIn() && (
        resource == null
        || resource.data.status in ['lobby', 'finished']
        || isMember(resource.data)
        || isKicked(resource.data)
      );
      allow create: if signedIn() && isNewRoom(code);
      allow update: if signedIn() && (
        isMemberUpdate()
        || isSelfJoin()
        || (resource.data.status == 'finished' && isNewRoom(code))
      );
      allow delete: if signedIn() && isMember(resource.data) && resource.data.playerUids.size() == 1;

      match /presence/{uid} {
        function room() {
          return get(/databases/$(database)/documents/rooms/$(code)).data;
        }

        allow read: if signedIn() && isMember(room());
        function isSelf() {
          return signedIn() && request.auth.uid == uid && isMember(room()) && !isKicked(room());
        }

        allow write: if isSelf()
          && request.resource.data.keys().hasOnly(['lastSeen'])
          && request.resource.data.lastSeen == request.time;
        allow delete: if isSelf();
      }
    }
  }
}
